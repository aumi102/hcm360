# ĐẠO ĐỨC 360 — production template (Vercel)
#
# PLACEHOLDERS ONLY. Never commit real values to this or any tracked file.
# Set these in Vercel: Project → Settings → Environment Variables.
#
# All four are REQUIRED. With any one missing, the app refuses to start a game in
# production rather than silently falling back to development behaviour:
#   * missing ADMIN_SECRET / SESSION_SECRET  -> host login refused
#   * missing Supabase                       -> host login and room creation refused,
#                                               because the in-memory adapter is correct
#                                               for one process and Vercel runs several
#
# All four are SERVER-SIDE ONLY. None is exposed to client JavaScript.

# Host password. Anyone holding it can start, skip and reset a live game.
#   openssl rand -base64 24
ADMIN_SECRET=<strong-random-secret>

# Cookie signing key, minimum 32 characters.
# Rotating it signs every active session out, so never change it during a lesson.
#   openssl rand -base64 48
SESSION_SECRET=<random-secret-at-least-32-characters>

# Supabase project URL.
#   Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase SERVICE ROLE key — full database access, bypasses Row Level Security.
#   Supabase → Project Settings → API → service_role  (NOT the anon key)
# If this ever leaks, rotate it in the Supabase dashboard immediately.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ---------------------------------------------------------------------------
# Optional. Leave unset on Vercel.
# The app derives its origin from x-forwarded-host / x-forwarded-proto, which Vercel
# always sets, so the QR code points at the real deployment with no configuration.
# Set it only to pin a custom domain when the deployment is reachable at several.
# NEXT_PUBLIC_APP_ORIGIN=https://<your-domain>
