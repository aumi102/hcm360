# ĐẠO ĐỨC 360 — local development template
#
# Copy to `.env.local` (git-ignored) and fill in only what you need.
#
# For production values see `.env.production.example` and `docs/DEPLOYMENT.md`.
#
# RULE: apart from NEXT_PUBLIC_APP_ORIGIN, no variable here may ever be given a
# NEXT_PUBLIC_ prefix. That prefix inlines the value into the browser bundle, where
# every student in the room can read it.

# ---------------------------------------------------------------------------
# Nothing below is required for local development.
# `npm run dev` works on a fresh clone with no .env.local at all: it falls back to
# the in-memory adapter and the development admin secret `hcm360-dev`.
# Those fallbacks are refused when NODE_ENV=production.
# ---------------------------------------------------------------------------

# Password typed at /host to take control of a game.
# Local default if unset: hcm360-dev
ADMIN_SECRET=

# Key used to sign host and player session cookies (HMAC-SHA256), min 32 chars.
# Local default if unset: a published development constant.
SESSION_SECRET=

# Set BOTH to develop against a real Supabase project instead of memory mode.
# Leave BOTH empty for in-memory development.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Leave empty: the app derives its origin from the request, which is what
# makes the projector QR code work when a phone opens the dev server over the LAN.
NEXT_PUBLIC_APP_ORIGIN=

# Optional, development only. Extra LAN origins `next dev` should accept, comma
# separated. Only needed when testing on a phone. No effect on a production build.
# DEV_ALLOWED_ORIGINS=192.168.2.220
