# ĐẠO ĐỨC 360 — environment variables
#
# Copy to `.env.local` and fill in. `.env.local` is git-ignored and must never be committed.
# Nothing in this file except NEXT_PUBLIC_APP_ORIGIN may ever be given a NEXT_PUBLIC_ prefix:
# that prefix inlines a value into the browser bundle, where it is readable by every student.

# ---------------------------------------------------------------- required in production

# Password the host types at /host to take control of a game.
# Use a long random string. Anyone who has it can start, skip and reset a live game.
#   openssl rand -base64 24
ADMIN_SECRET=

# Key used to sign the host and player session cookies (HMAC-SHA256).
# Must be at least 32 characters. Changing it invalidates every active session, which
# would sign every student out mid-game — so do not rotate it during a lesson.
#   openssl rand -base64 48
SESSION_SECRET=

# ---------------------------------------------------------------- Supabase (optional)

# Leave BOTH of these empty to run on the in-memory adapter (development / demo mode):
# the whole game works, but state lives in one server process and is lost on restart.
# Set BOTH to use Postgres. Production must set them — a serverless deployment runs
# several instances, and each would otherwise hold its own separate copy of the room.

# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# SERVICE ROLE key — full database access, bypasses Row Level Security.
# Server-side only. It must never appear in client code, a NEXT_PUBLIC_ variable, a
# commit, or a screenshot. If it leaks, rotate it in the Supabase dashboard immediately.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- optional

# Absolute origin used to build the QR code URL, e.g. https://hcm360.vercel.app
# Leave empty to derive it from the incoming request, which is what makes the QR
# scannable from a phone when running `next dev` on a laptop's LAN address.
NEXT_PUBLIC_APP_ORIGIN=
